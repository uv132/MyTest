@model IEnumerable<MyTest.Models.School>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SchoolName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.city)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Students)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.SchoolName)
            </td>
            <td>
                @Html.DisplayFor(model => item.city)
            </td>
            <td>
                @Html.DisplayFor(model => item.Students)
            </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.SchoolId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.SchoolId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.SchoolId">Delete</a> |
                    <a asp-action="WithStudents" asp-route-schoolid="@item.SchoolId">With Students</a>
                </td>
        </tr>
}
    </tbody>
</table>

