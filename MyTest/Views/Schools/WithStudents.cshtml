@model MyTest.Models.School

@{
    ViewData["Title"] = "School and Students Details";
}

<!-- Top section: School details -->
<div class="parent-card">
    <h2>@Model.SchoolName</h2>
    <div class="parent-fields">
        <div><span class="field-label">School ID:</span> @Model.SchoolId</div>
        <div><span class="field-label">City:</span> @Model.city</div>
    </div>
</div>

<!-- Bottom section: Linked students -->
<div class="children-section">
    <h3>
        Students
        <span class="count-badge">(@Model.Students.Count)</span>
    </h3>

    @if (Model.Students.Count == 0)
    {
        <p class="empty-message">No students found in this school.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Student ID</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model.Students)
                {
                    <tr>
                        <td>@student.Id</td>
                        <td>@student.FirstName</td>
                        <td>@student.LastName</td>
                        <td>
                            <a class="btn-details" asp-controller="Students" asp-action="Details" asp-route-id="@student.Id">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div>
    <a asp-action="Index">Back to Schools List</a>
</div>